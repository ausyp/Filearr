# Copy to .env (or paste into Portainer's stack environment variables)

# Image tag to run: test2, main/latest, or sha-<commit>
FILEARR_TAG=test2
FILEARR_PORT=8090

# Host folders
MEDIA_PATH=/path/to/your/media
DATA_PATH=./data

TMDB_API_KEY=
PUID=1000
PGID=1000

# Paths inside the container (under /media)
INPUT_DIR=/media/downloads
OUTPUT_DIR=/media/movies
MOVIES_DIR=/media/movies
MALAYALAM_DIR=/media/movies/malayalam-movies
REJECTED_DIR=/media/movies/rejected
